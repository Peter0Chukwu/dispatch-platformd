+                              <Button size="sm" variant="secondary" onClick={() => setDraft(draftFrom(row))}>
+                                Edit
+                              </Button>
+                              {row.isActive ? (
+                                <Button size="sm" variant="ghost" onClick={() => setConfirmHide(row)}>
+                                  Hide
+                                </Button>
+                              ) : (
+                                <Button
+                                  size="sm"
+                                  variant="ghost"
+                                  onClick={() => restore.mutate(row)}
+                                  disabled={restore.isPending}
+                                >
+                                  Restore
+                                </Button>
+                              )}
+                            </div>
