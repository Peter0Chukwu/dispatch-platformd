From 43db6496480e744ce850eaf3705b940246eb26f0 Mon Sep 17 00:00:00 2001
From: TWL Build <build@twl.local>
Date: Wed, 18 Nov 2026 19:07:48 +0000
Subject: [PATCH] email: the link stands alone, and the token is read back
 properly
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The password reset arrived with its link working but the sentence's full stop
attached to it — "?token=…VMXuM. If you did not ask" — and a mail client that
auto-links takes that full stop into the URL. The token then carried a character
that was never in it, and the API answered that the link was invalid. Both email
bodies now put the URL on its own line with no punctuation touching it.

That is only half of it, because people will still paste the whole link, or a
link with the full stop. cleanToken() now recovers the token from whatever they
send: takes the part after token=, stops at the first space, and keeps only
base64url characters. Applied on the server, so it does not matter which screen
the request came from.

While in the renderer, a real bug: .test() on a /g regex advances lastIndex, so
every other link in a message was left as raw text. Replaced with a split that
needs no state, and the href no longer swallows trailing punctuation.

Six tests added (99 total, no database); typecheck and production build clean.
---
 backend/src/auth/verification.service.ts   | 47 ++++++++++++++++++++--
 backend/src/messaging/messaging.service.ts | 17 ++++++--
 backend/test/messaging.spec.ts             | 31 ++++++++++++++
 backend/test/verification-link.spec.ts     | 38 ++++++++++++++++-
 4 files changed, 125 insertions(+), 8 deletions(-)

diff --git a/backend/src/auth/verification.service.ts b/backend/src/auth/verification.service.ts
index a7ca4ba..82d96d7 100644
--- a/backend/src/auth/verification.service.ts
+++ b/backend/src/auth/verification.service.ts
@@ -27,6 +27,24 @@ export function firstOrigin(value: string | undefined | null): string | null {
   return first.replace(/\/+$/, '');
 }
 
+/**
+ * The token, recovered from whatever a person pasted.
+ *
+ * Tokens are 43 characters of base64url. Every real failure on this has been a
+ * human one: the whole link pasted, a trailing full stop picked up from the end of
+ * the sentence, a space after a copy. Those are stripped here, on the server, so
+ * the fix does not depend on which screen the person used.
+ */
+export function cleanToken(raw: string): string {
+  const text = String(raw ?? '').trim();
+  const match = /[?&]token=([^&#\s]+)/.exec(text);
+  // First chunk only: a token is never followed by a space, so anything after one is
+  // the rest of the sentence.
+  const candidate = (match?.[1] ?? text).split(/\s+/)[0] ?? '';
+  // base64url only — a full stop, bracket or quote was never part of the token.
+  return candidate.replace(/[^A-Za-z0-9_-]/g, '');
+}
+
 const TTL = {
   EMAIL_VERIFY: 24 * 60 * 60 * 1000, // 24 hours
   PHONE_OTP: 10 * 60 * 1000, // 10 minutes
@@ -114,7 +132,15 @@ export class VerificationService {
       to: user.email,
       kind: 'EMAIL_VERIFICATION',
       subject: 'Verify your email address',
-      body: `Hello ${user.firstName}, confirm your email address to activate your account: ${link}\n\nThe link works for 24 hours.`,
+      body: [
+        `Hello ${user.firstName},`,
+        '',
+        'Confirm your email address to activate your account:',
+        '',
+        link,
+        '',
+        'The link works for 24 hours.',
+      ].join('\n'),
     });
     return {
       ...(this.exposeCodes ? { devToken: token } : {}),
@@ -123,7 +149,8 @@ export class VerificationService {
     };
   }
 
-  async verifyEmail(token: string): Promise<{ userId: string }> {
+  async verifyEmail(rawToken: string): Promise<{ userId: string }> {
+    const token = cleanToken(rawToken);
     const record = await this.prisma.verificationToken.findUnique({ where: { tokenHash: hash(token) } });
     if (!record || record.purpose !== 'EMAIL_VERIFY') {
       throw new AppError('VALIDATION_FAILED', 'This verification link is not valid', 400);
@@ -225,7 +252,18 @@ export class VerificationService {
       to: user.email,
       kind: 'PASSWORD_RESET',
       subject: 'Reset your password',
-      body: `Hello ${user.firstName}, use this link to choose a new password (valid for 1 hour): ${link}. If you did not ask for this, ignore this message.`,
+      // The link sits on its own line, with no punctuation touching it. A full stop
+      // straight after a URL is picked up by mail clients as part of the link, and
+      // the token then ends in a character that was never in it.
+      body: [
+        `Hello ${user.firstName},`,
+        '',
+        'Use this link to choose a new password — it works for one hour:',
+        '',
+        link,
+        '',
+        'If you did not ask for this, ignore this message.',
+      ].join('\n'),
     });
     return {
       ...(this.exposeCodes ? { devToken: token } : {}),
@@ -233,7 +271,8 @@ export class VerificationService {
     };
   }
 
-  async resetPassword(token: string, newPassword: string): Promise<void> {
+  async resetPassword(rawToken: string, newPassword: string): Promise<void> {
+    const token = cleanToken(rawToken);
     const record = await this.prisma.verificationToken.findUnique({ where: { tokenHash: hash(token) } });
     if (!record || record.purpose !== 'PASSWORD_RESET' || record.consumedAt || record.expiresAt.getTime() < Date.now()) {
       throw new AppError('VALIDATION_FAILED', 'This reset link is invalid or has expired. Request a new one.', 400);
diff --git a/backend/src/messaging/messaging.service.ts b/backend/src/messaging/messaging.service.ts
index 8970ec7..2f99884 100644
--- a/backend/src/messaging/messaging.service.ts
+++ b/backend/src/messaging/messaging.service.ts
@@ -201,10 +201,21 @@ function maskEmail(email: string): string {
  * verification link has to work in a phone's preview pane on a slow connection.
  */
 function renderEmail(message: OutboundMessage): string {
-  const linkPattern = /(https?:\/\/[^\s]+)/g;
+  // Two details that cost real emails:
+  //  · `.test()` on a /g regex advances lastIndex, so it answered differently for
+  //    every other part — half the links in a message were left as raw text.
+  //  · a full stop or bracket at the end of a sentence got swept into the href,
+  //    which made the token it carried invalid.
+  const isLink = /^https?:\/\//;
+  const trailing = /[.,;:!?)\]]+$/;
   const linked = message.body
-    .split(linkPattern)
-    .map((part) => (linkPattern.test(part) ? `<a href="${part}" style="color:#047857">${part}</a>` : escapeHtml(part)))
+    .split(/(https?:\/\/\S+)/g)
+    .map((part) => {
+      if (!isLink.test(part)) return escapeHtml(part);
+      const url = part.replace(trailing, '');
+      const tail = part.slice(url.length);
+      return `<a href="${escapeHtml(url)}" style="color:#047857">${escapeHtml(url)}</a>${escapeHtml(tail)}`;
+    })
     .join('');
   return `<!doctype html><html><body style="margin:0;padding:24px;background:#f8fafc;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif">
   <div style="max-width:520px;margin:0 auto;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:24px">
diff --git a/backend/test/messaging.spec.ts b/backend/test/messaging.spec.ts
