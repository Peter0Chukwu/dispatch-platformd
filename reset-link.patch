@@ -134,6 +134,37 @@ describe('phase 7 — outbound messages', () => {
       expect(body.html).toContain('href="https://twl.example.com/verify?token=abc"');
     });
 
+    it('keeps a sentence-ending full stop out of the link', async () => {
+      // The exact shape that broke a real password reset:
+      // "... token=abc. If you did not ask for this..."
+      fetchMock.mockResolvedValue({ ok: true, status: 200, text: async () => '{}' });
+
+      await new MessagingService(resendConfig).sendEmail({
+        ...email,
+        body: 'Reset here: https://twl.example.com/reset-password?token=abc123. If you did not ask, ignore.',
+      });
+
+      const body = JSON.parse((fetchMock.mock.calls[0] as [string, RequestInit])[1].body as string);
+      expect(body.html).toContain('href="https://twl.example.com/reset-password?token=abc123"');
+      expect(body.html).not.toContain('abc123."');
+      // The full stop is still in the sentence, just not in the link.
+      expect(body.html).toContain('</a>. If you did not ask');
+    });
+
+    it('linkifies every link in a message, not every other one', async () => {
+      // A /g regex reused with .test() alternates true/false, which silently left
+      // half the links as plain text.
+      fetchMock.mockResolvedValue({ ok: true, status: 200, text: async () => '{}' });
+
+      await new MessagingService(resendConfig).sendEmail({
+        ...email,
+        body: 'One: https://twl.example.com/a Two: https://twl.example.com/b Three: https://twl.example.com/c',
+      });
+
+      const body = JSON.parse((fetchMock.mock.calls[0] as [string, RequestInit])[1].body as string);
+      expect(body.html.match(/<a href=/g)).toHaveLength(3);
+    });
+
     it('escapes the message so a name cannot inject markup', async () => {
       fetchMock.mockResolvedValue({ ok: true, status: 200, text: async () => '{}' });
 
diff --git a/backend/test/verification-link.spec.ts b/backend/test/verification-link.spec.ts
index a1dddc7..af91224 100644
--- a/backend/test/verification-link.spec.ts
+++ b/backend/test/verification-link.spec.ts
@@ -1,5 +1,5 @@
 import { describe, expect, it } from 'vitest';
-import { firstOrigin } from '../src/auth/verification.service';
+import { cleanToken, firstOrigin } from '../src/auth/verification.service';
 
 /**
  * The link inside a verification email.
@@ -36,3 +36,39 @@ describe('phase 7 — the address in a verification link', () => {
     expect(firstOrigin(',https://b.example')).toBe('https://b.example');
   });
 });
+
+/**
+ * The token a person actually sends back.
+ *
+ * Both failures here are copies of what really happened: a full stop glued to the
+ * end of the link by the sentence, and the whole URL pasted into a box that wanted
+ * only the code.
+ */
+describe('phase 7 — reading the token back', () => {
+  const token = '3xCfKl3MuCo4qPeh5VZur4K80n05ML_T3gv2dcVMXuM';
+
+  it('accepts the bare token', () => {
+    expect(cleanToken(token)).toBe(token);
+  });
+
+  it('drops the full stop a sentence left behind', () => {
+    expect(cleanToken(`${token}.`)).toBe(token);
+  });
+
+  it('pulls the token out of a whole pasted link, punctuation and all', () => {
+    expect(cleanToken(`https://www.example.com/reset-password?token=${token}.`)).toBe(token);
+  });
+
+  it('survives a leading or trailing space from a copy', () => {
+    expect(cleanToken(`  ${token}  `)).toBe(token);
+  });
+
+  it('stops at the first space, so the rest of the sentence is not swallowed', () => {
+    expect(cleanToken(`${token} and then some words`)).toBe(token);
+  });
+
+  it('returns something that simply will not match when the input is nonsense', () => {
+    // No crash, no exception — just a token that the lookup will refuse.
+    expect(cleanToken('not a link at all')).toBe('not');
+  });
+});
