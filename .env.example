# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE. Copy to backend/.env and fill in. NEVER commit real secrets.
#   cp .env.example backend/.env
# Secrets must be long random strings:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Proxy hops in front of the API (0 in development, 1 behind nginx, 2 behind Caddy+nginx).
TRUST_PROXY=0
APP_NAME=Dispatch Platform
APP_TIMEZONE=Africa/Lagos

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dispatch_dev?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dispatch_dev_test?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-a-different-random-value
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
TRACKING_LINK_SECRET=replace-with-another-random-value

CORS_ORIGINS="http://localhost:5173"
# The address the browser should be sent back to (tracking links, payment returns).
FRONTEND_URL=http://localhost:5173

# DEVELOPMENT = simulated payments (backend-only simulator, no real money).
# SANDBOX = Paystack/Flutterwave test keys.  LIVE = real keys (production server only).
PAYMENTS_MODE=DEVELOPMENT
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

MAPS_PROVIDER=STUB            # STUB | GOOGLE | MAPBOX
GOOGLE_MAPS_API_KEY=

SMS_MODE=CONSOLE              # CONSOLE | TERMII
TERMII_API_KEY=
TERMII_SENDER_ID=Dispatch

# MASKED CALLS — the customer and rider reach each other through a proxy number,
# so neither ever sees the other's real one. CONSOLE means "not connected yet":
# the Call button explains that instead of dialling nothing. Switching to TERMII
# also needs a verified Termii account, an approved caller ID and a number pool.
VOICE_MODE=CONSOLE            # CONSOLE | TERMII
TERMII_VOICE_NUMBER_POOL=

EMAIL_MODE=CONSOLE            # CONSOLE | RESEND
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

STORAGE_DRIVER=LOCAL          # LOCAL | S3 | CLOUDINARY
STORAGE_LOCAL_DIR=./storage

DEFAULT_COMMISSION_PCT=20
DISPATCH_OFFER_TIMEOUT_SECONDS=20
DISPATCH_MAX_ACTIVE_PER_RIDER=2
TRACKING_PING_INTERVAL_SECONDS=15
LOCATION_RETENTION_DAYS=30
