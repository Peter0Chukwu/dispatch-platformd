# ─────────────────────────────────────────────────────────────────────────────
# Web image — the React SPA, built once, served by Nginx
#
# The browser talks to the same origin for everything: `/api/v1` and `/socket.io`
# are proxied to the API container, so the refresh cookie stays first-party and no
# CORS rule has to be loosened for production.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS build
WORKDIR /app

# ── Two things that make this build fail in ways that read like the code's fault ──
#
# 1. NODE_ENV. vite, the React plugin, Tailwind, PostCSS and TypeScript are all
#    devDependencies of the web workspace. If the platform's build environment ever
#    carries NODE_ENV=production, `npm ci` skips every one of them and the failure
#    surfaces later as "Cannot find module" from a step that looks unrelated. Naming
#    it here means the build does not depend on what the host happens to export.
# 2. Memory. A production Vite build of this app is small, but a constrained builder
#    can still be killed mid-transform, and an OOM kill shows up as a plain exit
#    code 1 with no useful message. This gives the build room before that happens.
ENV NODE_ENV=development \
    NODE_OPTIONS=--max-old-space-size=2048
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci --include=dev --workspace @dispatch/web --workspace @dispatch/shared --include-workspace-root

COPY packages/shared ./packages/shared
COPY frontend ./frontend
# Vite compiles the shared package from source, so no shared build step is needed.
# Anything the browser must know at build time is passed in here.
ARG VITE_GEOAPIFY_API_KEY=""
ARG VITE_GOOGLE_MAPS_API_KEY=""
ARG VITE_APP_NAME="Dispatch"
ENV VITE_GEOAPIFY_API_KEY=$VITE_GEOAPIFY_API_KEY \
    VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY \
    VITE_APP_NAME=$VITE_APP_NAME
# A typecheck that REPORTS but does not gate the build. It costs a few seconds and
# turns "vite exited 1" into "src/pages/x.tsx(12,8): Cannot find module './y'" in the
# log — which is the difference between a five-minute fix and a guessing game.
RUN cd frontend && (npx tsc --noEmit || echo 'TYPECHECK REPORTED ERRORS (see above) — continuing to the build')

# The local binary, not `npx`: npx will happily download a different Vite when the
# local one is missing, and then the failure is about the wrong version of the wrong
# tool instead of the missing dependency that caused it.
RUN cd frontend && node -v && ../node_modules/.bin/vite --version && ../node_modules/.bin/vite build

# If the build was killed rather than failed, there is no error message to read and
# the platform reports only an exit code. This turns that silence into one sentence
# in the log, because the next step (COPY --from=build) would otherwise report a
# missing folder without saying why.
RUN test -f frontend/dist/index.html || (echo 'BUILD PRODUCED NO index.html — if the step above ended without an error, the process was killed (memory), not rejected.' && exit 1)

FROM nginx:1.27-alpine AS runtime
# Where the API lives. The default keeps `docker compose up` working unchanged;
# a hosting platform overrides it with its own internal service address.
ENV API_UPSTREAM=api:4000
# nginx's own entrypoint renders every *.template here into /etc/nginx/conf.d/
# at start-up, substituting only variables present in the environment — so
# ${API_UPSTREAM} is filled in and nginx's $uri/$host survive untouched.
COPY deploy/nginx-templates/ /etc/nginx/templates/
# The header/proxy snippets are `include`d by the template. They live in their own
# files because nginx does not merge `add_header`/`proxy_set_header` down into a
# location that defines its own — see the comment at the top of nginx.conf.
COPY deploy/nginx-snippets/ /etc/nginx/snippets/
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
