# Nginx in front of the SPA.
#
# This file is a TEMPLATE. It is copied to /etc/nginx/templates/ and rendered to
# /etc/nginx/conf.d/default.conf at start-up, with ${API_UPSTREAM} taken from the
# environment. Only that one variable is substituted: nginx's own $uri, $host and
# $http_upgrade are left alone because envsubst is given only the variables that
# actually exist in the container.
#
# Everything the browser needs is same-origin: the static app, the API under
# /api/v1, and the socket under /socket.io. That is what keeps the HttpOnly
# refresh cookie first-party and lets CORS stay a closed list.
#
# ── Two nginx traps this file is written around ──────────────────────────────
#
# 1. `add_header` does NOT merge with the parent block. If a `location` defines
#    even one `add_header`, every inherited one is dropped for that location — so
#    a `Cache-Control` inside `location /` would silently remove the CSP from the
#    HTML itself. The security headers therefore live in a snippet that every
#    block that sets headers includes explicitly.
#
# 2. `proxy_set_header` behaves the same way. Setting just `Connection ""` inside
#    `location /api/` would drop the X-Forwarded-* headers from the server block,
#    which makes the API see the proxy's IP for every user. The proxy headers are
#    likewise a snippet, included in both proxy locations.

# ── reusable snippets ────────────────────────────────────────────────────────
# Included by the server block and by every location that adds its own headers.
# Kept at the top level because `include` inside `server` is allowed but these
# must be re-applied per location.

# The API's address comes from the environment, so the same image works on a
# compose network (api:4000, the default), on a hosted platform where services
# find each other by an internal DNS name, or beside an API on another machine.
# nginx renders this file through envsubst at container start; see Dockerfile.web.
upstream dispatch_api {
    server ${API_UPSTREAM};
    keepalive 32;
}

server {
    listen 80;
    server_name _;

    # Uploads travel as base64 inside JSON, so the request body limit must be at
    # least the API's own parser limit (8 MB) plus a little overhead.
    client_max_body_size 12m;

    # ── security headers (see trap 1 — repeated in each location below) ──────
    include /etc/nginx/snippets/dispatch-headers.conf;

    # ── compression ──────────────────────────────────────────────────────────
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
    # Do not compress already-compressed images or files.

    # ── static app ───────────────────────────────────────────────────────────
    root /usr/share/nginx/html;
    index index.html;

    location /assets/ {
        include /etc/nginx/snippets/dispatch-headers.conf;
        # Vite fingerprints these filenames, so they can be cached forever.
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/dispatch-headers.conf;
        # SPA fallback: /admin/reports must return index.html, not a 404.
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }

    # ── API ──────────────────────────────────────────────────────────────────
    location /api/ {
        include /etc/nginx/snippets/dispatch-proxy.conf;
        proxy_pass http://dispatch_api;
        # A report download streams a file; do not buffer the whole thing.
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    # ── sockets ──────────────────────────────────────────────────────────────
    location /socket.io/ {
        include /etc/nginx/snippets/dispatch-proxy.conf;
        proxy_pass http://dispatch_api;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    # ── the API's own liveness, for container-level probes ───────────────────
    location = /healthz {
        include /etc/nginx/snippets/dispatch-headers.conf;
        proxy_pass http://dispatch_api/api/v1/health/live;
        access_log off;
    }
}
