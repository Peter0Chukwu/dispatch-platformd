# ─────────────────────────────────────────────────────────────────────────────
# Deployment environment for docker-compose.yml
#
#   cp deploy/.env.example deploy/.env
#   # fill in every value marked CHANGE ME, then:
#   docker compose up -d --build
#
# deploy/.env is git-ignored and must never be committed. Generate secrets with:
#   openssl rand -hex 48
# ─────────────────────────────────────────────────────────────────────────────

# ── database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password
POSTGRES_DB=dispatch
# Inside compose the host is the service name, `postgres`. `?schema=public` is a
# Prisma parameter; the backup scripts strip it before calling pg_dump.
DATABASE_URL=postgresql://dispatch:CHANGE_ME_strong_database_password@postgres:5432/dispatch?schema=public

# ── cache / queue / sockets ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_PREFIX=api/v1
APP_NAME=Dispatch
APP_TIMEZONE=Africa/Lagos
# The public origin of this deployment (scheme + host, no trailing slash).
# This must match EXACTLY what the browser types, or sign-in fails in the browser
# while every curl test passes.
CORS_ORIGINS=https://dispatch.example.com
FRONTEND_URL=https://dispatch.example.com

# Where the web container is published. Bound to loopback by default because TLS
# is terminated in front of it (Caddy on the host). Set WEB_BIND=0.0.0.0 only if
# you are exposing it directly.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# How many reverse proxies sit in front of the API.
#   1 = nginx container only (no TLS proxy in front)
#   2 = Caddy -> nginx            (the recommended setup)
#   3 = Cloudflare -> Caddy -> nginx
# Wrong value = every user shares one per-IP rate-limit bucket.
TRUST_PROXY=2

# ── secrets: CHANGE ME, all of them ──────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_48
JWT_REFRESH_SECRET=CHANGE_ME_a_different_openssl_rand_hex_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Signs tracking share links and report download links. Rotating it invalidates
# every outstanding link — which is exactly what you want if one leaks.
TRACKING_LINK_SECRET=CHANGE_ME_openssl_rand_hex_48

# ── payments ─────────────────────────────────────────────────────────────────
# DEVELOPMENT simulates charges through the same code path as a real webhook.
# Switch to LIVE only after the go-live checklist (documentation/GO-LIVE-CHECKLIST.md).
PAYMENTS_MODE=DEVELOPMENT
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=CHANGE_ME_from_paystack_dashboard
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxx
FLUTTERWAVE_WEBHOOK_HASH=CHANGE_ME_from_flutterwave_dashboard

# ── maps ─────────────────────────────────────────────────────────────────────
# STUB works with no key and says so in the UI. Set GOOGLE + the web build arg
# (VITE_GOOGLE_MAPS_API_KEY) to switch to real maps.
MAPS_PROVIDER=STUB
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# ── messaging ────────────────────────────────────────────────────────────────
# CONSOLE logs messages instead of sending them — never use it for real riders.
SMS_MODE=CONSOLE
TERMII_API_KEY=
TERMII_SENDER_ID=Dispatch

# MASKED CALLS — the customer and rider reach each other through a proxy number,
# so neither ever sees the other's real one. CONSOLE means "not connected yet":
# the Call button explains that instead of dialling nothing. Switching to TERMII
# also needs a verified Termii account, an approved caller ID and a number pool.
VOICE_MODE=CONSOLE            # CONSOLE | TERMII
TERMII_VOICE_NUMBER_POOL=
EMAIL_MODE=CONSOLE
RESEND_API_KEY=
EMAIL_FROM=Dispatch <no-reply@dispatch.example.com>

# ── storage / operations ─────────────────────────────────────────────────────
STORAGE_DRIVER=LOCAL
STORAGE_LOCAL_DIR=./storage
DEFAULT_COMMISSION_PCT=20
DISPATCH_OFFER_TIMEOUT_SECONDS=45
DISPATCH_MAX_ACTIVE_PER_RIDER=1
TRACKING_PING_INTERVAL_SECONDS=15
LOCATION_RETENTION_DAYS=30
