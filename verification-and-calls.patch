+    const call: LiveCall = {
+      id: randomUUID(),
+      deliveryId: delivery.id,
+      callerUserId: principal.userId,
+      calleeUserId: peerUserId,
+      callerType,
+      startedAt: Date.now(),
+      answeredAt: null,
+    };
