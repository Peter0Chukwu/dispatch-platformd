+    const callerType: 'CUSTOMER' | 'RIDER' = isCustomer ? 'CUSTOMER' : 'RIDER';
+    const peerUserId = await this.peerUserIdFor(delivery, callerType === 'CUSTOMER' ? 'RIDER' : 'CUSTOMER');
