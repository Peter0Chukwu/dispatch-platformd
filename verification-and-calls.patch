 SMS_MODE=CONSOLE              # CONSOLE | TERMII
 TERMII_API_KEY=
 TERMII_SENDER_ID=TWL
+TERMII_CHANNEL=dnd            # dnd (transactional, required for OTP) | generic
 
-# MASKED CALLS — the customer and rider reach each other through a proxy number,
-# so neither ever sees the other's real one. CONSOLE means "not connected yet":
-# the Call button explains that instead of dialling nothing. Switching to TERMII
-# also needs a verified Termii account, an approved caller ID and a number pool.
-VOICE_MODE=CONSOLE            # CONSOLE | TERMII
+# ── CALLS between customer and rider ─────────────────────────────────────────
+# IN_APP   — the call happens inside the app (WebRTC, browser to browser). No
+#            phone number exists on either side, so nothing can be revealed.
+#            Needs no provider, no KYC and no credit. This is the default.
+# TERMII   — Termii rents a proxy number and bridges the two phones. Needs a
+#            number-masking account: KYC, a rented number pool and per-minute
+#            billing, activated by Termii support (not self-serve).
+# CONSOLE  — calling off; the Call button says messaging is the way to talk.
+VOICE_MODE=IN_APP             # IN_APP | CONSOLE | TERMII
 TERMII_VOICE_NUMBER_POOL=
 
 EMAIL_MODE=CONSOLE            # CONSOLE | RESEND
